{
  "name": "@bvdmitri/webtween",
  "version": "0.2.1",
  "description": "Smooth slow motion in the browser: frames generated between frames by a neural network, on WebGPU.",
  "license": "MIT",
  "author": "bvdmitri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvdmitri/webtween.git",
    "directory": "packages/webtween"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models/*": "./models/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "models"
  ],
  "scripts": {
    "build": "node ../../tools/pack/src/main.ts && tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@webgpu/types": "0.1.74",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@webtween/core": "workspace:*",
    "@webtween/onnx": "workspace:*",
    "@webtween/webgpu": "workspace:*",
    "tsdown": "0.23.0",
    "vitest": "4.1.11",
    "webgpu": "0.6.2",
    "@webtween/pack": "workspace:*"
  },
  "keywords": [
    "slow motion",
    "frame interpolation",
    "rife",
    "webgpu",
    "webcodecs",
    "onnx"
  ],
  "homepage": "https://github.com/bvdmitri/webtween#readme",
  "bugs": {
    "url": "https://github.com/bvdmitri/webtween/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
