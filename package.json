{
  "name": "webtween-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Smooth slow motion in the browser: in-between frames generated by a neural network on WebGPU",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": "^24 || ^26"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise packages tools --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "pnpm --filter @webtween/core test:mutation",
    "checks": "node tools/checks/src/main.ts --all",
    "verify": "pnpm checks && pnpm typecheck && pnpm lint && pnpm format:check && pnpm depcruise && pnpm test:coverage",
    "docs:api": "typedoc",
    "docs:build": "pnpm docs:api && vitepress build docs",
    "docs:dev": "pnpm docs:api && vitepress dev docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-istanbul": "4.1.11",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-es-x": "10.1.0",
    "eslint-plugin-unicorn": "78.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitepress": "1.6.4",
    "vitest": "4.1.11"
  }
}
